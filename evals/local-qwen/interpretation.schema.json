{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "intent": {
      "type": "string",
      "enum": [
        "ask_question",
        "probe_interest",
        "argument",
        "offer",
        "concession",
        "counter_offer",
        "pressure",
        "empathy",
        "objection",
        "clarification",
        "reveal_information",
        "close_attempt",
        "walk_away"
      ]
    },
    "tone": {
      "type": "string",
      "enum": [
        "neutral",
        "respectful_firm",
        "accusatory",
        "threat"
      ]
    },
    "primaryTopicId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "secondaryTopicId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "factIds": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "argument": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "claimId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            },
            "supportingFactIds": {
              "minItems": 1,
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              }
            },
            "evidenceSpan": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1999
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "claimId",
            "supportingFactIds",
            "evidenceSpan"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "acknowledgementFactId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "offerDraft": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "terms": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "issueId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  },
                  "valueId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                  }
                },
                "required": [
                  "issueId",
                  "valueId"
                ],
                "additionalProperties": false
              }
            },
            "conditionalOn": {
              "anyOf": [
                {
                  "minItems": 1,
                  "maxItems": 2,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "issueId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                      },
                      "valueId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                      }
                    },
                    "required": [
                      "issueId",
                      "valueId"
                    ],
                    "additionalProperties": false
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "terms",
            "conditionalOn"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "targetOfferId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceSpans": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1999
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        },
        "required": [
          "start",
          "end"
        ],
        "additionalProperties": false
      }
    },
    "needsClarification": {
      "type": "boolean"
    },
    "clarification": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "intent",
    "tone",
    "primaryTopicId",
    "secondaryTopicId",
    "factIds",
    "argument",
    "acknowledgementFactId",
    "offerDraft",
    "targetOfferId",
    "evidenceSpans",
    "needsClarification",
    "clarification"
  ],
  "additionalProperties": false
}
