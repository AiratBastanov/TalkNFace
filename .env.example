NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/arena.sqlite
ACCESS_PROFILE=local
# Same-origin browser URL; default is http://HOST:PORT. For npm run dev use http://127.0.0.1:5173.
APP_ORIGIN=http://127.0.0.1:3000
# Optional: absent means player path works, administrator login is disabled.
# Generate with node scripts/admin-password.mjs (hidden input), or node scripts/local-demo.mjs.
# Never put plaintext passwords in command arguments or commit a real hash.
# ADMIN_PASSWORD_HASH=<output of the local hash generator>
# Future TLS profile: ACCESS_PROFILE=public, APP_ORIGIN=https://your-host.example
# Requires HTTPS termination on a controlled host; proxy/hosting certification is separate.
